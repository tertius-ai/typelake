{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scitype:spec:discovery:v1",
  "title": "Discovery document",
  "description": "Served at /.well-known/typelake.json. The entry point an agent reads before anything else: everything a human can see must be fetchable as data.",
  "type": "object",
  "required": ["scitype_registry", "collections", "volumes"],
  "additionalProperties": false,
  "properties": {
    "scitype_registry": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["collection", "manifest"],
        "properties": {
          "collection": { "type": "string" },
          "manifest": { "type": "string", "format": "uri" },
          "snapshot": { "type": "string" }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["volume", "manifest"],
        "properties": {
          "volume": { "type": "string" },
          "manifest": { "type": "string", "format": "uri" },
          "doi": { "type": "string" }
        }
      }
    }
  }
}
