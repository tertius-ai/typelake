{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scitype:2608.0014",
  "title": "Conjugacy class of subgroups",
  "description": "Non-conjugate subgroups can be abstractly isomorphic, so a class cannot be pinned by its isomorphism type. Identity depends on the ambient's canonical id.",
  "type": "object",
  "properties": {
    "ambient": {
      "type": "object",
      "properties": {
        "degree": {
          "type": "integer"
        },
        "generators": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "degree",
        "generators"
      ],
      "$comment": "inlined from scitype:2608.0004",
      "description": "policy: primary."
    },
    "representative_generators": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "description": "in the ambient's canonical labelling. policy: primary."
    },
    "order": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "description": "policy: derived-cheap."
    },
    "index": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "description": "policy: derived-cheap."
    },
    "class_size": {
      "type": "integer",
      "description": "policy: derived-cheap."
    },
    "is_normal": {
      "type": "boolean",
      "description": "policy: derived-cheap."
    },
    "is_sylow": {
      "type": "boolean",
      "description": "policy: derived-cheap."
    }
  },
  "required": [
    "ambient",
    "representative_generators"
  ]
}
